#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/workdesk/workdesk /usr/bin/workdesk

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/workdesk.service ]; then
			rm -f /etc/systemd/system/workdesk.service /usr/lib/systemd/system/workdesk.service /usr/lib/systemd/user/workdesk.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/workdesk/files/systemd/workdesk.service /usr/lib/systemd/system/workdesk.service
		# try fix error in Ubuntu 18.04
		# Failed to reload workdesk.service: Unit workdesk.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/workdesk.service:10: Executable path is not absolute: pkill -f "workdesk --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/workdesk.service
		fi
		systemctl daemon-reload
		systemctl enable workdesk
		systemctl start workdesk
	fi
fi
